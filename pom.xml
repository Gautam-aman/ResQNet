<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.resqnet</groupId>
  <artifactId>resqnet-parent</artifactId>
  <!-- Single version authority for the whole repository. Every module
       inherits it, and the Android app mirrors it in build.gradle, so the
       release tag and the shipped artifacts cannot drift apart. -->
  <version>0.2.0-beta</version>
  <packaging>pom</packaging>

  <name>ResQNet Parent</name>
  <description>
    ResQNet - decentralized offline-first emergency communication network.
    Aggregator for the pure-Java mesh core, the deterministic mesh simulator and
    the Spring Boot coordination gateway.
  </description>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>packages/mesh-core</module>
    <module>packages/mesh-simulator</module>
    <module>services/backend</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      Reproducible archives.

      Without a fixed output timestamp every build stamps the current time into
      the jar entries, so two builds of identical source differ byte for byte
      and a published SHA-256 means nothing. This pins the timestamp and the
      entry order, so the checksum in the release notes is a claim somebody can
      check rather than a number that changes every time the build runs.
    -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <junit.version>6.1.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <spring.boot.version>3.5.9</spring.boot.version>
    <springdoc.version>2.8.9</springdoc.version>
    <!--
      HPKE implementation used by mesh-core. The Android build pins the same
      version of tink-android explicitly.
    -->
    <tink.version>1.24.0</tink.version>

    <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.6.1</maven.surefire.plugin.version>
    <maven.failsafe.plugin.version>3.6.1</maven.failsafe.plugin.version>
    <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
    <!-- Integration tests need a live PostgreSQL; see the failsafe config. -->
    <skipITs>true</skipITs>
    <!-- Overridden to an empty value by the CI step that runs slow tests. -->
    <excludedTestGroups>slow</excludedTestGroups>
    <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.crypto.tink</groupId>
        <artifactId>tink</artifactId>
        <version>${tink.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.resqnet</groupId>
        <artifactId>mesh-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.resqnet</groupId>
        <artifactId>mesh-simulator</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <!--
              -parameters is required, not optional. Spring resolves @RequestParam
              and @PathVariable by parameter name at runtime; without it the
              compiled classes do not retain those names and every such endpoint
              fails at request time with a 400.
            -->
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
            <!--
              Full recompilation whenever the module is touched.

              The default incremental mode decided "nothing to compile" after
              source files had genuinely changed, and kept class files that
              referenced types which no longer existed. The failure was silent:
              the build passed and the stale class threw
              "Unresolved compilation problem" at runtime, three separate times
              during M10 before the cause was identified.

              A compiler that occasionally skips a real change is worse than
              one that recompiles slightly too eagerly.
            -->
            <useIncrementalCompilation>false</useIncrementalCompilation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
          <configuration>
            <argLine>-Xmx1g -Djava.awt.headless=true</argLine>
            <!--
              "slow" is opt-in, not opt-out. Some tests here run whole simulated
              meshes rather than methods; they are worth running but would triple
              the build for every push. CI runs them in a dedicated step with
              -DexcludedGroups=, so nothing is actually skipped there.
            -->
            <excludedGroups>${excludedTestGroups}</excludedGroups>
            <!--
              Use the class directory, not the packaged artifact.

              spring-boot:repackage replaces the project artifact with an
              executable jar whose classes live under BOOT-INF/classes. Plain
              classloading cannot read that layout, so without this the forked
              test JVM fails to resolve project classes and reports
              "ClassSelector resolution failed / NoClassDefFoundError" for
              classes that are present on disk. Naming the directory removes the
              ambiguity.
            -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven.failsafe.plugin.version}</version>
          <!--
            Integration tests are opt-in, and the flag defaults to off.

            failsafe runs on `mvn verify`, so without this an ordinary build
            picks up every integration test class. The PostgreSQL ones need a
            live server that a developer or a plain CI job does not have, and
            the failure mode was a JUnit discovery error that looked like a
            broken test suite rather than a missing database.

            A test that needs external infrastructure should have to ask for
            it. Enable by setting the skipITs property to false.
          -->
          <configuration>
            <skipITs>${skipITs}</skipITs>
            <!-- See the surefire note: the repackaged jar is not loadable. -->
            <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          </configuration>
          <executions>
            <execution>
              <goals>
                <goal>integration-test</goal>
                <goal>verify</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>